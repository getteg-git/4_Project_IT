PGHOST=localhost
PGPORT=5432
PGUSER=admin
PGPASSWORD=admin123
PGDATABASE=logindb
PGSSLMODE=disable
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Optional; defaults to SMTP_SENDER when SMTP_PASSWORD is set.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=true
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
# Optional for localhost development; set a random value of at least 32 characters for stable sessions.
SESSION_SECRET=
# Enable when the backend is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Optional in development: strict (default), lax, or none (requires Secure=true).
SESSION_COOKIE_SAMESITE=strict

